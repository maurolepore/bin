#!/bin/bash
# gww - copy branch name matching pattern to clipboard

if [ -z "$1" ]; then
    echo "Usage: gww <pattern>"
    exit 1
fi

pattern="$1"

# Find branches matching the pattern (case-insensitive)
matches=$(git branch | sed 's/^[* ] //' | grep -i "$pattern")

if [ -z "$matches" ]; then
    echo "No branches match '$pattern'"
    exit 1
fi

# Count matches
match_count=$(echo "$matches" | wc -l | tr -d ' ')

if [ "$match_count" -eq 1 ]; then
    echo -n "$matches" | pbcopy
    echo "$matches (copied)"
else
    echo "Multiple branches match '$pattern':"
    echo "$matches"
    exit 1
fi
