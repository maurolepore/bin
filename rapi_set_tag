#!/bin/bash
# Set the RAPI_IMAGE_TAG on Heroku

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/_rapi_resolve_app"

show_help() {
  cat << 'EOF'
Usage: rapi_set_tag <new-tag> <app-name> [--force]

Set the RAPI_IMAGE_TAG for a Heroku app.

Arguments:
  new-tag     The rapi image tag to set (e.g., build-7496)
  app-name    Heroku app name (required)

Options:
  -f, --force   Allow downgrade to older version
  -h, --help    Show this help message

Shortcuts:
  production, staging, apple, andrew, banana, cherry,
  drew, durian, egg, fortaleza, guava, jeff, vlad

Examples:
  rapi_set_tag build-7500 banana          # Set Banana dev tag
  rapi_set_tag build-7500 production      # Set production tag
  rapi_set_tag build-7400 staging --force # Downgrade staging
EOF
}

set -e

FORCE=false
ARGS=()

# Parse arguments
for arg in "$@"; do
  if [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
    FORCE=true
  elif [ "$arg" = "--help" ] || [ "$arg" = "-h" ]; then
    show_help
    exit 0
  else
    ARGS+=("$arg")
  fi
done

TAG="${ARGS[0]}"
APP_INPUT="${ARGS[1]}"

if [ -z "$TAG" ] || [ -z "$APP_INPUT" ]; then
  show_help
  exit 1
fi

APP=$(resolve_app "$APP_INPUT") || exit 1

# Get current tag
CURRENT=$(heroku config:get RAPI_IMAGE_TAG -a "$APP" 2>/dev/null || echo "")

if [ -z "$CURRENT" ]; then
  echo "No current RAPI_IMAGE_TAG set. Setting to: $TAG"
  heroku config:set RAPI_IMAGE_TAG="$TAG" -a "$APP"
  exit 0
fi

if [ "$TAG" = "$CURRENT" ]; then
  echo "Tag is already set to: $TAG"
  exit 0
fi

# Compare versions (strip 'v' prefix if present, compare with sort -V)
compare_versions() {
  local v1="${1#v}"
  local v2="${2#v}"
  # Returns 0 if v1 > v2, 1 otherwise
  [ "$(printf '%s\n%s' "$v1" "$v2" | sort -V | tail -n1)" = "$v1" ] && [ "$v1" != "$v2" ]
}

if compare_versions "$TAG" "$CURRENT"; then
  echo "Upgrading: $CURRENT -> $TAG"
  heroku config:set RAPI_IMAGE_TAG="$TAG" -a "$APP"
elif [ "$FORCE" = true ]; then
  echo "Downgrading (forced): $CURRENT -> $TAG"
  heroku config:set RAPI_IMAGE_TAG="$TAG" -a "$APP"
else
  echo "Error: Refusing to downgrade from $CURRENT to $TAG"
  echo "Use --force to override"
  exit 1
fi
